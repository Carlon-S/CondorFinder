# Copiar a backendModel/.env (gitignored) y completar con valores reales.
# Nunca committear el .env real.

# Connection string de MongoDB Atlas (Database > Connect > Drivers).
# OJO: la plantilla que da Atlas por defecto NO incluye el nombre de la base
# en el path — no hace falta agregarlo ahí, se define aparte en MONGODB_DB_NAME.
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Nombre de la base a usar dentro del cluster (se crea sola en el primer insert).
MONGODB_DB_NAME=condorfinder

# Secreto para firmar los JWT de sesión — cualquier string largo y aleatorio,
# por ejemplo generado con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Minutos de validez de la sesión antes de tener que volver a loguearse.
JWT_EXPIRE_MINUTES=480

# Usuario admin sembrado al arrancar el backend (solo si no existe ya en Mongo).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# Nombre del bucket de Google Cloud Storage donde se guardan los resultados
# (PNG del mapa + JSON de detecciones) de cada análisis — ver storage.py.
# OPCIONAL para desarrollo local: si se deja vacío, el backend cae solo a
# guardar/servir esos archivos desde disco local (comportamiento de antes
# de GCS) — no hace falta cuenta de GCP para correr el backend en tu WSL.
# Solo la VM en producción lo setea de verdad. La autenticación es vía
# Application Default Credentials, no una key acá: en la VM la da la
# service account adjunta a la instancia; si quisieras probar el modo GCS
# en tu propia máquina, `gcloud auth application-default login`.
GCS_BUCKET_NAME=

# Host desde el que el FRONTEND alcanza este backend — se usa para construir
# result_url/result_json_url. En desarrollo local no hace falta setearlo
# (default http://localhost:8000). En la VM: http://<IP_VM>:8000.
PUBLIC_BASE_URL=http://localhost:8000

# Host desde el que ESTE proceso alcanza a NodeODM. En WSL local no hace
# falta setearlo (default localhost, NodeODM en la misma máquina). En
# docker-compose: nodeodm (nombre del servicio, ver docker-compose.yml).
NODEODM_HOST=localhost
