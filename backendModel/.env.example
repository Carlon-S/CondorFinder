MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=condorfinder
JWT_SECRET=
JWT_EXPIRE_MINUTES=480

# =============================================================================
# INICIO DE SESIÓN FEDERADO (OpenID Connect)
#
# La identidad la emite un proveedor externo y este backend solo decide quién
# entra. Cada proveedor necesita sus DOS credenciales: con una sola, ese botón
# no se ofrece, para que un .env a medio llenar no deje el login en un estado
# que nadie quiso.
# =============================================================================

# Microsoft Entra ID: el cliente (funcionarios de la Municipalidad de Maipú).
# Se registra en portal.azure.com, Microsoft Entra ID > App registrations.
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Qué DIRECTORIOS pueden entrar, separados por coma. No son correos: es el
# identificador del directorio que emitió el token (el claim `tid`).
#
# Entrar por directorio y no por lista de correos es lo que hace que un
# funcionario nuevo entre el día que su TI le crea la cuenta, y deje de entrar
# el día que se la cierran, sin tocar este archivo.
#
# 7254b8cd-... es la Municipalidad de Maipú, obtenido de su endpoint público de
# descubrimiento. Es una LISTA y una variable a propósito: se le puede agregar
# otro directorio (el de la universidad, por ejemplo) para recorrer el flujo
# completo con una cuenta propia antes de tener una del cliente.
AUTH_MS_TENANTS=7254b8cd-2f8a-46df-bbb5-9bd7df4153ba

# Google: la puerta del equipo de desarrollo.
# Se registra en console.cloud.google.com, en el MISMO proyecto que la VM.
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=

# Acá sí va una lista de correos, porque del lado de Google no hay directorio
# que signifique algo: aceptar "cualquier cuenta de Google" sería aceptar a todo
# el planeta.
AUTH_EMAILS_PERMITIDOS=condorfinder@gmail.com

# A dónde vuelve el navegador cuando el proveedor termina. En producción es el
# dominio del FRONTEND, que no es el de este backend. Sin definir, asume el dev
# server de Vite.
# PUBLIC_APP_URL=https://condorfinder.cl

# =============================================================================
# LOGIN POR CONTRASEÑA, SOLO DESARROLLO
#
# Sin esta variable el endpoint /auth/login devuelve 404 y no se siembra ningún
# usuario: el secreto compartido deja de existir. NO la definas en la VM.
#
# Sirve para levantar el proyecto sin credenciales de Azure ni de Google.
# =============================================================================
# ALLOW_PASSWORD_LOGIN=true
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_PASSWORD=

# Opcionales — solo se usan en el despliegue en la VM de GCP (docker-compose).
# Sin ellas, el backend asume desarrollo 100% local (localhost:8000, NodeODM
# también en localhost, sin subir resultados a GCS).
# GCS_BUCKET_NAME=condorfinder-results-<sufijo>
# PUBLIC_BASE_URL=https://api.condorfinder.cl
# NODEODM_HOST=nodeodm

# Opcional — HDU5/AC2 (generación de ruta real, backendModel/osrm_client.py).
# Sin ella, usa el servidor demo público de OSRM (router.project-osrm.org):
# sin SLA/garantía de uptime, aceptable para este sprint. Overridear con un
# servidor OSRM propio si esto pasa a producción real.
# OSRM_BASE_URL=https://router.project-osrm.org

# Opcionales - HDU5.1/AC5 (tiempos de cada tramo con el tráfico del momento,
# backendModel/google_routes_client.py). SIN ESTAS DOS, todo el ruteo se
# calcula con OSRM a flujo libre, que es el estado por omisión y lo que
# permite correr el backend sin una clave de Google.
#
# ROUTES_PROVIDER=google es el interruptor; sin él la clave se ignora.
# ROUTES_PROVIDER=google
# GOOGLE_ROUTES_API_KEY=
#
# La clave se cobra por llamada (SKU `Compute Routes Pro`, 5.000 gratis al
# mes). El sistema gasta UNA llamada por recorrido generado, pero el techo de
# costo NO lo pone el código: antes de crear la clave hay que configurar en
# GCP la cuota diaria de la Routes API en 160 solicitudes (160 x 31 = 4.960,
# bajo el tramo gratuito), y restringir la clave a la IP de la VM y a la
# Routes API. Si Google falla o se agota la cuota, el backend cae solo a OSRM.

# Opcionales — solo para cuando el FRONTEND también está desplegado
# (Cloudflare Workers), donde los fetches del navegador son cross-origin
# de verdad (sin el proxy same-origin del dev server de Vite). Sin
# COOKIE_SECURE=true, la cookie de sesión sigue en modo local
# (secure=False, samesite="lax") — no actives esto sin HTTPS real en el
# backend, los navegadores descartan cookies Secure sobre HTTP plano.
# EXTRA_CORS_ORIGINS=https://condorfinder.diegogcs2003.workers.dev,https://condorfinder.cl
# COOKIE_SECURE=true
# COOKIE_DOMAIN=.condorfinder.cl
