# Instala las dependencias en un node_modules plano, sin la carpeta de enlaces
# simbolicos de pnpm.
#
# El build de Cloudflare fallaba con "Rollup failed to resolve import" sobre un
# paquete distinto en cada intento (@radix-ui/react-context, sonner,
# @radix-ui/primitive), con el mismo commit y el mismo lockfile, y tambien con
# la cache de build desactivada. Era un enlace simbolico de pnpm que faltaba en
# el entorno de build. En un node_modules plano Rollup encuentra cada paquete
# subiendo por las carpetas, sin depender de esos enlaces.
node-linker=hoisted
