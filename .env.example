# Copiar a .env (gitignored) en la raíz del repo.
#
# URL del backend al que habla el frontend. No es un secreto (es solo una
# IP/host), pero cada integrante puede querer un valor distinto según qué
# esté probando — por eso no se sube el .env real, solo esta plantilla.

# Backend compartido en la nube (GCP) — usar esto por defecto para trabajar
# con las mismas zonas que el resto del equipo.
VITE_BACKEND_URL=http://35.209.42.9:8000

# Para probar cambios de backend en tu propio WSL local antes de subirlos,
# comenta la línea de arriba y descomenta esta (o simplemente borra el
# archivo — el fallback en src/lib/config.ts ya apunta acá por defecto):
# VITE_BACKEND_URL=http://localhost:8000
